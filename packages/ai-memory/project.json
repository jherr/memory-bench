{
  "name": "ai-memory",
  "projectType": "library",
  "sourceRoot": "packages/ai-memory/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ai-memory",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ai-memory",
        "command": "vitest run"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/ai-memory",
        "command": "tsc --noEmit -p tsconfig.json"
      }
    }
  }
}
